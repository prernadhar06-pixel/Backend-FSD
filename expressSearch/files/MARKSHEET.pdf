    <script type="text/JavaScript">

        function check_fut_Dateper(sender, args) {
            var fuData = document.getElementById('_hdndate').value;
            var stri = fuData.split(' ');
            if (sender._selectedDate > new Date(stri[0], stri[1] - 1, stri[2])) {
                alert("Future Date can't be selected !");
                sender._textbox._element.value = '';
            }
        }

        function checkDatenotallowFd(sender, args) {
            var today = new Date();
            var tomorrow = new Date();
            tomorrow.setDate(today.getDate() - 1);
            if (sender._selectedDate < tomorrow) {
                sender._textbox.set_Value(null)
                alert("You cannot select a previous date");
            }
        }


        function noneOnly(event, txt) {
            if (event.keyCode != 9) {
                event.returnValue = false;
                txt.value = '';
            }

        }

        function checkAlphabets(evt) {
            evt = (evt) ? evt : window.event
            var charCode = (evt.which) ? evt.which : evt.keyCode
            if ((charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122) ||
                (charCode == 32) || (charCode == 8) || (charCode == 9) || (charCode == 127) || (charCode >= 37 && charCode <= 40) || (charCode == 8) || (charCode == 46)) {
                status = ""
                return true
            }
            status = ""
            return false
        }

        function checkNumeric(evt) {
            evt = (evt) ? evt : window.event

            var charCode = (evt.which) ? evt.which : evt.keyCode

            if ((charCode != 31 && (charCode < 48 || charCode > 57) && (charCode < 35 || charCode > 41)) && (charCode != 46) && (charCode != 8) && (charCode != 9)) {
                status = "This field accepts numbers only.";
                return false
            }
            status = ""
            return true
        }




    </script>
